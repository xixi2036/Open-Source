<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+：allowBackup=false 挡不住“设备到设备迁移”。本地数据库由 Keystore 中不可导出的密钥加密，
    迁移到新设备后无法解密，身份密钥也不应离开本机，所以云备份与设备迁移都排除全部数据。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
